Bootstrap: docker
From: ghcr.io/astral-sh/uv:0.12.1
Stage: uv

Bootstrap: docker
From: nvidia/cuda:12.6.3-cudnn-runtime-ubuntu24.04
Stage: runtime

%files from uv
    /uv /usr/local/bin/uv
    /uvx /usr/local/bin/uvx

%files
    apptainer/requirements.lock /opt/chess/requirements.lock
    apptainer/check_runtime.py /opt/chess/check_runtime.py

%post
    set -eu
    test "$(uname -m)" = x86_64
    apt-get update
    apt-get install -y --no-install-recommends ca-certificates libgomp1 cuda-nvcc-12-6
    rm -rf /var/lib/apt/lists/*
    # Install outside /root so ordinary users can execute the interpreter.
    export UV_PYTHON_INSTALL_DIR=/opt/python
    uv python install 3.12.12
    uv venv --python 3.12.12 /opt/venv
    uv pip sync --python /opt/venv/bin/python --require-hashes --only-binary :all: --no-cache /opt/chess/requirements.lock
    chmod -R a+rX /opt/python /opt/venv
    test -x /usr/local/cuda/bin/ptxas
    test -f /usr/local/cuda/nvvm/libdevice/libdevice.10.bc
    mkdir -p /workspace/train /mnt/chess-data

%environment
    export VIRTUAL_ENV=/opt/venv
    export PATH=/opt/venv/bin:/usr/local/bin:$PATH
    export PYTHONNOUSERSITE=1
    export TF_USE_LEGACY_KERAS=0
    export KERAS_BACKEND=tensorflow
    export UV_PYTHON_INSTALL_DIR=/opt/python
    export CUDA_HOME=/usr/local/cuda
    export PATH=/usr/local/cuda/bin:$PATH
    export XLA_FLAGS="${XLA_FLAGS:---xla_gpu_cuda_data_dir=/usr/local/cuda}"
    # Prefer image CUDA/cuDNN; retain the driver path injected by --nv.
    export LD_LIBRARY_PATH=/usr/local/cuda/lib64:/usr/lib/x86_64-linux-gnu${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}

%test
    /usr/local/bin/uv --version
    TF_USE_LEGACY_KERAS=0 KERAS_BACKEND=tensorflow PYTHONNOUSERSITE=1 /opt/venv/bin/python /opt/chess/check_runtime.py

%runscript
    exec /opt/venv/bin/python "$@"

%labels
    TensorFlow 2.20.0
    Python 3.12.12
    Keras 3
    UV 0.12.1
    CUDA 12.6.3
    cuDNN 9.5.1
    BaseImage nvidia/cuda:12.6.3-cudnn-runtime-ubuntu24.04

%help
    Build from the train project root on Linux x86_64:
      apptainer build --fakeroot tensorflow-2.20-uv.sif apptainer/tensorflow.def
    Check GPU execution on an allocated GPU node:
      apptainer exec --nv tensorflow-2.20-uv.sif python /opt/chess/check_runtime.py --gpu
    CUDA/cuDNN/NCCL come from NVIDIA CUDA runtime; cuda-nvcc-12-6 adds ptxas and libdevice.
