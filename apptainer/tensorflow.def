Bootstrap: docker
From: ghcr.io/astral-sh/uv:0.12.1
Stage: uv

Bootstrap: docker
From: ubuntu:24.04
Stage: tensorflow_builder

%arguments
    BUILD_JOBS=8
    BUILD_RAM_MB=32768

%post
    set -eu
    test "$(uname -m)" = x86_64
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y --no-install-recommends ca-certificates curl gnupg git build-essential python3 python3-dev zip unzip patch patchelf
    curl -fsSL https://apt.llvm.org/llvm-snapshot.gpg.key -o /tmp/llvm.key
    gpg --dearmor --output /usr/share/keyrings/llvm.gpg /tmp/llvm.key
    echo 'deb [signed-by=/usr/share/keyrings/llvm.gpg] https://apt.llvm.org/noble/ llvm-toolchain-noble-20 main' > /etc/apt/sources.list.d/llvm20.list
    apt-get update
    apt-get install -y --no-install-recommends clang-20 lld-20
    curl -fL --retry 3 https://github.com/bazelbuild/bazel/releases/download/7.4.1/bazel-7.4.1-linux-x86_64 -o /usr/local/bin/bazel
    curl -fL --retry 3 https://github.com/bazelbuild/bazel/releases/download/7.4.1/bazel-7.4.1-linux-x86_64.sha256 -o /tmp/bazel.sha256
    (cd /tmp && ln -s /usr/local/bin/bazel bazel-7.4.1-linux-x86_64 && sha256sum -c bazel.sha256)
    chmod 755 /usr/local/bin/bazel
    git clone --depth 1 --branch v2.20.0 https://github.com/tensorflow/tensorflow.git /opt/tensorflow-src
    # Hermetic Python must be built by a non-root account.
    useradd --create-home --shell /bin/bash tfbuild
    chown -R tfbuild:tfbuild /opt/tensorflow-src
    cat > /tmp/build-tensorflow.sh <<'BUILD'
#!/bin/bash
set -euo pipefail
export PATH=/usr/lib/llvm-20/bin:/usr/local/bin:/usr/bin:/bin
export CC=/usr/lib/llvm-20/bin/clang
export CXX=/usr/lib/llvm-20/bin/clang++
cd /opt/tensorflow-src
bazel --batch build \
    --config=cuda_clang --config=cuda_wheel \
    --repo_env=CC=/usr/lib/llvm-20/bin/clang \
    --repo_env=CLANG_CUDA_COMPILER_PATH=/usr/lib/llvm-20/bin/clang \
    --repo_env=USE_HERMETIC_CC_TOOLCHAIN=0 \
    --repo_env=HERMETIC_CUDA_VERSION=12.8.1 \
    --repo_env=HERMETIC_CUDNN_VERSION=9.8.0 \
    --repo_env=HERMETIC_CUDA_COMPUTE_CAPABILITIES=compute_120 \
    --repo_env=HERMETIC_PYTHON_VERSION=3.12 \
    --repo_env=WHEEL_NAME=tensorflow \
    --repo_env=ML_WHEEL_TYPE=release \
    --repo_env=ML_WHEEL_VERSION_SUFFIX= \
    --jobs={{ BUILD_JOBS }} --local_ram_resources={{ BUILD_RAM_MB }} \
    //tensorflow/tools/pip_package:wheel
mkdir -p /home/tfbuild/wheels
cp bazel-bin/tensorflow/tools/pip_package/wheel_house/tensorflow-2.20.0-*.whl /home/tfbuild/wheels/
git rev-parse HEAD > /home/tfbuild/wheels/tensorflow-source-commit.txt
BUILD
    chmod 755 /tmp/build-tensorflow.sh
    runuser -u tfbuild -- /bin/bash /tmp/build-tensorflow.sh
    chmod -R a+rX /home/tfbuild/wheels

Bootstrap: docker
From: nvidia/cuda:12.8.1-cudnn-runtime-ubuntu24.04
Stage: runtime

%files from uv
    /uv /usr/local/bin/uv
    /uvx /usr/local/bin/uvx

%files from tensorflow_builder
    /home/tfbuild/wheels /opt/chess/wheels

%files
    pyproject.toml /opt/chess/pyproject.toml

%post
    set -eu
    test "$(uname -m)" = x86_64
    apt-get update
    apt-get install -y --no-install-recommends ca-certificates libgomp1 cuda-nvcc-12-8
    rm -rf /var/lib/apt/lists/*
    # Install outside /root so ordinary users can execute the interpreter.
    export UV_PYTHON_INSTALL_DIR=/opt/python
    uv python install 3.12.12
    # Only the container copy gets a wheel source override; Mac keeps PyPI.
    uv run --no-project --python 3.12.12 python - <<'PYBUILD'
from pathlib import Path
import tomllib
project = Path('/opt/chess/pyproject.toml')
wheels = list(Path('/opt/chess/wheels').glob('tensorflow-2.20.0-*.whl'))
assert len(wheels) == 1, wheels
assert 'tensorflow==2.20.0' in tomllib.loads(project.read_text())['project']['dependencies']
with project.open('a') as f:
    f.write('\n[tool.uv.sources]\ntensorflow = { path = "' + str(wheels[0]) + '" }\n')
PYBUILD
    # Resolve for the build environment; no host uv.lock is copied.
    # Source code is mounted by run_train_apptainer.sh at execution time.
    UV_PROJECT_ENVIRONMENT=/opt/venv uv sync --project /opt/chess --python 3.12.12 --no-install-project --no-dev --no-cache
    chmod -R a+rX /opt/python /opt/venv
    test -x /usr/local/cuda/bin/ptxas
    test -f /usr/local/cuda/nvvm/libdevice/libdevice.10.bc
    mkdir -p /workspace/train /mnt/chess-data

%environment
    export VIRTUAL_ENV=/opt/venv
    export PATH=/opt/venv/bin:/usr/local/bin:$PATH
    export PYTHONNOUSERSITE=1
    export TF_USE_LEGACY_KERAS=0
    export KERAS_BACKEND=tensorflow
    export UV_PYTHON_INSTALL_DIR=/opt/python
    export CUDA_HOME=/usr/local/cuda
    export PATH=/usr/local/cuda/bin:$PATH
    export XLA_FLAGS="${XLA_FLAGS:---xla_gpu_cuda_data_dir=/usr/local/cuda}"
    # Prefer image CUDA/cuDNN; retain the driver path injected by --nv.
    export LD_LIBRARY_PATH=/usr/local/cuda/lib64:/usr/lib/x86_64-linux-gnu${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}

%runscript
    exec /opt/venv/bin/python "$@"

%labels
    TensorFlow 2.20.0
    TensorFlowBuild source-sm120
    Compiler Clang20
    Python 3.12.12
    Keras 3
    UV 0.12.1
    CUDA 12.8.1
    cuDNN 9.8.0
    BaseImage nvidia/cuda:12.8.1-cudnn-runtime-ubuntu24.04

%help
    Build from the train project root on Linux x86_64:
      apptainer build --fakeroot tensorflow-2.20-blackwell.sif apptainer/tensorflow.def
    CUDA/cuDNN/NCCL come from NVIDIA CUDA runtime; cuda-nvcc-12-8 adds ptxas and libdevice.
